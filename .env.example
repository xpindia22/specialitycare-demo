APP_NAME="SpecialityCare Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────────────────
# Import databases/specialitycare-demo.sql into this database (see README).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=specialitycare_demo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ── Mail (demo: just logs emails to storage/logs/laravel.log) ───────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin event notifications (leave blank in the demo)
ADMIN_NOTIFY_EMAIL=
ADMIN_NOTIFY_ENABLED=false

# ── WhatsApp / SMS (disabled in the demo — add your own provider creds) ──────
WHATSAPP_PROVIDER=twilio
TWILIO_SID=
TWILIO_TOKEN=
META_WA_TOKEN=
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=
GUPSHUP_APP_NAME=

# ── Modules / licensing ─────────────────────────────────────────────────────
# Public key for the BUNDLED 6-month demo license in demo-license/.
# Copy demo-license/license.json + license.sig into storage/license/ (see README).
# The license expires on 2027-05-22 — after that, modules lock automatically.
# Do NOT set MODULES_DEV_OVERRIDE=true if you want the demo to expire as intended.
MODULES_PUBLIC_KEY=7iUzZVnNv0M3jZFLGWRfoCWAK4xVSDWV0m/SPXyavIw=
MODULES_DEV_OVERRIDE=false
# Leave heartbeat blank — the demo license enforces its own expiry offline.
# MODULES_HEARTBEAT_URL=

# Owner panel (leave blank to keep it 404)
OWNER_KEY=

VITE_APP_NAME="${APP_NAME}"

# ── Hidden owner access + login activity ────────────────────────────────────
# Comma-separated emails treated as HIDDEN owner accounts: full access but
# filtered out of Users / Doctors / Staff listings. Leave blank in the demo.
OWNER_HIDDEN_EMAILS=
LOGIN_ACTIVITY_LOG=true
LOGIN_ACTIVITY_GEO=true
